# Managed by Ansible (role: sportsbook).
[Unit]
Description=sportsbook workload: a sportsbook's players, odds feed and batch jobs on MySQL
Wants=network-online.target
After=network-online.target docker.service

[Service]
User={{ sportsbook_user }}
Group={{ sportsbook_user }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ sportsbook_dir }}/venv/bin/python {{ sportsbook_dir }}/sportsbook.py workload --config /etc/sportsbook/workload.json
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
