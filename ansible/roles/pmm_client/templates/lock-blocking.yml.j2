# Managed by Ansible (role: pmm_client).
# Custom queries for PMM's PostgreSQL exporter: who blocks whom. PostgreSQL keeps no history of lock waits,
# so PMM samples them, at its high resolution (5 s by default). The dashboard for these metrics is
# "PostgreSQL lock blocking" (files/postgresql-lock-blocking-dashboard.json).
#
# "master: true" makes the exporter run a query once per server. Without it, the exporter runs every
# custom query in each database, and these queries cover the whole server.
#
# Root blocker: PostgreSQL reports sessions queued on the same row as blocking each other. The queries walk
# each queue back to its root: the session that is in the way and is not waiting on a lock itself.
#
# Persisting blockers only: a root blocker is reported once its transaction has been open for {{ pmm_client_lock_blocking_min_seconds }} s. A healthy
# database has many lock waits of a few milliseconds, and the problem is the lock that persists. The filter
# is on the blocker, not on the waiting sessions, because a session that gives up after its lock_timeout
# never waits for long, even when the same blocker stops the application for minutes.

# Who blocks: per database, user, application and state of the root blockers. Few, stable series:
# the one to graph over time.
pg_lock_blocking:
  master: true
  query: |
    WITH RECURSIVE waiting AS (
        SELECT a.pid, b.pid AS blocker_pid
        FROM pg_stat_activity a
        CROSS JOIN LATERAL unnest(pg_blocking_pids(a.pid)) AS b(pid)
        WHERE a.wait_event_type = 'Lock'
    ), chain AS (
        SELECT DISTINCT w.blocker_pid AS root_pid, w.pid AS waiting_pid
        FROM waiting w
        WHERE w.blocker_pid NOT IN (SELECT pid FROM waiting)
      UNION
        SELECT c.root_pid, w.pid
        FROM chain c
        JOIN waiting w ON w.blocker_pid = c.waiting_pid
    )
    SELECT coalesce(r.datname, '') AS datname,
           coalesce(r.usename, r.backend_type) AS blocking_user,
           coalesce(nullif(r.application_name, ''), r.backend_type) AS blocking_application,
           coalesce(r.state, '') AS blocking_state,
           count(DISTINCT c.root_pid) AS blockers,
           count(DISTINCT c.waiting_pid) AS sessions,
           max(extract(epoch FROM clock_timestamp() - coalesce(r.xact_start, r.state_change))) AS transaction_seconds
    FROM chain c
    JOIN pg_stat_activity r ON r.pid = c.root_pid
    WHERE coalesce(r.xact_start, r.state_change) <= clock_timestamp() - make_interval(secs => {{ pmm_client_lock_blocking_min_seconds }})
    GROUP BY 1, 2, 3, 4
    ORDER BY sessions DESC
    LIMIT 50
  metrics:
    - datname:
        usage: "LABEL"
        description: "Database of the root blocker"
    - blocking_user:
        usage: "LABEL"
        description: "User of the root blocker"
    - blocking_application:
        usage: "LABEL"
        description: "application_name of the root blocker"
    - blocking_state:
        usage: "LABEL"
        description: "State of the root blocker: active, or idle in transaction"
    - blockers:
        usage: "GAUGE"
        description: "Sessions of this user and application that are root blockers"
    - sessions:
        usage: "GAUGE"
        description: "Sessions waiting on a lock behind these root blockers, directly or in a queue"
    - transaction_seconds:
        usage: "GAUGE"
        description: "Seconds the oldest of these root blockers' transactions has been open"

# What they run: the same, per statement of the root blocker, for the ten that block the most sessions.
# The statement is the one the blocker runs now or ran last, not always the one that took the lock.
# Its text is a label: a statement with literal values makes a new series each time.
pg_lock_blocking_statement:
  master: true
  query: |
    WITH RECURSIVE waiting AS (
        SELECT a.pid, b.pid AS blocker_pid
        FROM pg_stat_activity a
        CROSS JOIN LATERAL unnest(pg_blocking_pids(a.pid)) AS b(pid)
        WHERE a.wait_event_type = 'Lock'
    ), chain AS (
        SELECT DISTINCT w.blocker_pid AS root_pid, w.pid AS waiting_pid
        FROM waiting w
        WHERE w.blocker_pid NOT IN (SELECT pid FROM waiting)
      UNION
        SELECT c.root_pid, w.pid
        FROM chain c
        JOIN waiting w ON w.blocker_pid = c.waiting_pid
    )
    SELECT coalesce(r.datname, '') AS datname,
           coalesce(r.usename, r.backend_type) AS blocking_user,
           coalesce(nullif(r.application_name, ''), r.backend_type) AS blocking_application,
           coalesce(r.state, '') AS blocking_state,
           left(regexp_replace(r.query, '\s+', ' ', 'g'), 100) AS blocking_query,
           count(DISTINCT c.waiting_pid) AS sessions,
           max(extract(epoch FROM clock_timestamp() - coalesce(r.xact_start, r.state_change))) AS transaction_seconds
    FROM chain c
    JOIN pg_stat_activity r ON r.pid = c.root_pid
    WHERE coalesce(r.xact_start, r.state_change) <= clock_timestamp() - make_interval(secs => {{ pmm_client_lock_blocking_min_seconds }})
    GROUP BY 1, 2, 3, 4, 5
    ORDER BY sessions DESC
    LIMIT 10
  metrics:
    - datname:
        usage: "LABEL"
        description: "Database of the root blocker"
    - blocking_user:
        usage: "LABEL"
        description: "User of the root blocker"
    - blocking_application:
        usage: "LABEL"
        description: "application_name of the root blocker"
    - blocking_state:
        usage: "LABEL"
        description: "State of the root blocker: active, or idle in transaction"
    - blocking_query:
        usage: "LABEL"
        description: "Current or last statement of the root blocker, first 100 characters"
    - sessions:
        usage: "GAUGE"
        description: "Sessions waiting on a lock behind this root blocker, directly or in a queue"
    - transaction_seconds:
        usage: "GAUGE"
        description: "Seconds the root blocker's transaction has been open"

# Who waits: by database, user and application of the waiting sessions.
#   sessions:         every session waiting on a lock right now, however briefly.
#   blocked_sessions: of those, the ones behind a persisting root blocker.
#
# This is where the totals come from. The two queries above count per blocker, and a session that waits
# behind several root blockers is counted under each of them: three reports holding a table that 21
# sessions wait for gave 3 x 21. Here every waiting session is one row, so the numbers add up.
pg_lock_waiting:
  master: true
  query: |
    WITH RECURSIVE waiting AS (
        SELECT a.pid, b.pid AS blocker_pid
        FROM pg_stat_activity a
        CROSS JOIN LATERAL unnest(pg_blocking_pids(a.pid)) AS b(pid)
        WHERE a.wait_event_type = 'Lock'
    ), chain AS (
        SELECT DISTINCT w.blocker_pid AS root_pid, w.pid AS waiting_pid
        FROM waiting w
        WHERE w.blocker_pid NOT IN (SELECT pid FROM waiting)
      UNION
        SELECT c.root_pid, w.pid
        FROM chain c
        JOIN waiting w ON w.blocker_pid = c.waiting_pid
    ), blocked AS (
        SELECT DISTINCT c.waiting_pid
        FROM chain c
        JOIN pg_stat_activity r ON r.pid = c.root_pid
        WHERE coalesce(r.xact_start, r.state_change) <= clock_timestamp() - make_interval(secs => {{ pmm_client_lock_blocking_min_seconds }})
    )
    SELECT coalesce(a.datname, '') AS datname,
           coalesce(a.usename, a.backend_type) AS waiting_user,
           coalesce(nullif(a.application_name, ''), a.backend_type) AS waiting_application,
           count(*) AS sessions,
           count(b.waiting_pid) AS blocked_sessions
    FROM pg_stat_activity a
    LEFT JOIN blocked b ON b.waiting_pid = a.pid
    WHERE a.wait_event_type = 'Lock'
    GROUP BY 1, 2, 3
  metrics:
    - datname:
        usage: "LABEL"
        description: "Database of the waiting sessions"
    - waiting_user:
        usage: "LABEL"
        description: "User of the waiting sessions"
    - waiting_application:
        usage: "LABEL"
        description: "application_name of the waiting sessions"
    - sessions:
        usage: "GAUGE"
        description: "Sessions waiting on a lock"
    - blocked_sessions:
        usage: "GAUGE"
        description: "Of the waiting sessions, those behind a persisting root blocker. Each is counted once."
