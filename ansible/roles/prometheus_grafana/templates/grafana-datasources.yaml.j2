# Managed by Ansible (role: prometheus_grafana). Provisioned: Grafana creates it on start, and it can't be
# changed in the UI.
apiVersion: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false
    jsonData:
      timeInterval: {{ prometheus_grafana_scrape_interval }} # the scrape interval: rate() windows no shorter than it
